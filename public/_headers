# Cloudflare Pages response headers (served from the site root).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite output is content-hashed: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# NASA terrain data, textures and the intro film are static files with fixed names: cache for a day, revalidate after.
/lunar/*
  Cache-Control: public, max-age=86400
/intro/*
  Cache-Control: public, max-age=86400
/mascot/*
  Cache-Control: public, max-age=86400
